            <component
              refId="Package\Cargar datos tabla hechos\Origen de OLE DB"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen de OLE DB"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 

--count(*)
--ids
P.producto_id as id_producto, p.proveedorId as proveedor_id, v.cliente_id as cliente_id, format(v.fecha, 'ddMMyyyy') as fecha_id, v.vendedor_id as vendedor_id, s.id_sucursal as sucursal_id,
--caracteristicas
dv.cantidad as cantidad, p.precio as precio_bruto, (p.precio * cantidad) * 0.19 as precio_total, 
CASE WHEN vt.costo_total &gt;= 150000 THEN 0 ELSE 50000 END AS costo_envio,
0 as descuentos, 
-- falta una tabla para indicar la entrega del producto, para calcular el tiempo de entrega, ademas para manejar un estado del producto, la ubicacion que fue enviada la compra
CASE WHEN vt.costo_total &lt;= 50000 THEN 5 WHEN vt.costo_total &lt;= 100000 THEN 10 WHEN vt.costo_total &lt;= 150000 THEN 20 WHEN vt.costo_total &lt;= 200000 THEN 35 ELSE 90 END AS distancia,
p.peso as peso_producto,
--id del registro
CONCAT(dv.producto_id, '-' ,dv.venta_id) as id,
e.fecha_entrega as fecha_entrega,
e.estado_entrega as estado_entrega,
DATEDIFF(DAY, v.fecha, e.fecha_entrega) as tiempo_entrega
--,CONCAT('dic_',REPLACE(LEFT(c.comuna,5),' ', ''), e.direccion_entrega) as direccion_entrega
,de.id_sucursal as direccion_destino,
v.venta_id as id_venta


from detalle_ventas as dv 
join ventas as v on (dv.venta_id = v.venta_id) 
join productos as p on (p.producto_id = dv.producto_id) 
join entregas e on (e.venta_id = v.venta_id)

join
(select s.sucursal_id as id, CONCAT('suc_',REPLACE(LEFT(c.comuna,5),' ', ''), s.sucursal_id) as id_sucursal,
s.sucursal as nombres_sucursal, c.comuna as nombre_comuna , p.nombreProvincia as nombre_provincia,
r.nombreRegion as nombre_region
from sucursales as s join comunas as c on (c.comuna_id = s.comuna_id) join PROVINCIA as p on (p.provinciaid = c.provinciaid) join REGION as r on (r.regionId = p.regionId)
) s on (s.id = v.sucursal_id)

join (select v.venta_id as id, sum(dv.cantidad * dv.precio_unitario) * 0.19 as costo_total from ventas v join detalle_ventas dv on(dv.venta_id = v.venta_id) group by v.venta_id) vt on (v.venta_id = vt.id)

join (select CONCAT('dic_',REPLACE(LEFT(c.comuna,5),' ', ''), s.direccion_entrega) as id_sucursal, s.entrega_id as id
from entregas as s join comunas as c on (c.comuna_id = s.comuna_id) join PROVINCIA as p on (p.provinciaid = c.provinciaid) join REGION as r on (r.regionId = p.regionId)) de on (de.id = e.entrega_id)

;</property>
