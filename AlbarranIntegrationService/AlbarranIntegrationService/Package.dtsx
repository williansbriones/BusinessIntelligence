                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select CONCAT('dic_',REPLACE(LEFT(c.comuna,5),' ', ''), s.direccion_entrega) as id_sucursal,
s.direccion_entrega  as nombres_sucursal, c.comuna as nombre_comuna , p.nombreProvincia as nombre_provincia,
r.nombreRegion as nombre_region
from entregas as s join comunas as c on (c.comuna_id = s.comuna_id) join PROVINCIA as p on (p.provinciaid = c.provinciaid) join REGION as r on (r.regionId = p.regionId);</property>
